# Godot 4+ specific ignores
.godot/
/android/

# macOS
.DS_Store

# .NET
bin/
obj/

# Mapa de referência: vem extraído do cliente original, então fica
# local. Versionar republicaria arte de terceiros — e 22 MB de binário
# por commit. Veja src/assets/maps/LEIA-ME.md.
src/assets/maps/arrival/

# Python
__pycache__/

# Pacotes NuGet locais do Godot .NET (cópia de GodotSharp/Tools/nupkgs,
# só para compilar fora do editor). Cada máquina tem os seus.
src/tools/nupkgs/

# Texturas que o Godot extrai dos .fbx na importação (exo_gray_0.png,
# mutant_red_1.png...). Saem do próprio .fbx, então cada máquina gera
# as suas.
src/assets/personagens/**/*_[0-9].png
src/assets/personagens/**/*_[0-9].png.import
src/assets/personagens/**/*_alpha_[0-9].png
src/assets/personagens/**/*_alpha_[0-9].png.import

# Pacotes de arte baixados (Poly Haven, Sketchfab): matéria-prima,
# grande, refeita por src/tools/baixar_pacotes.py. Veja docs/PACOTES.md.
src/assets/pacotes/

# Os segredos do servidor (copie de .env.exemplo).
.env

# Pasta de troca de arquivos com o Claude (pacotes e bundles): não versionar.
.synctmp/

# Medidas locais do src/tools/medir_lobo.sh
.medidas/

# Jogo exportado (export_presets.cfg)
build/
# o .dmg do Mac feito aqui (src/tools/lancamento/mac_local.sh)
/dmg/
/entrega/
_to_delete/

# Pacotes de entrega e sincronização entre agentes (nunca versionar)
_sync*.tgz
entrega*.tgz
_mac_*.txt

# Cenas do Blender das poses com arma (~22 MB cada, com texturas): geradas por
# src/tools/personagens/blender/poses_armas.py --blend
src/tools/personagens/blender/poses/*.blend
