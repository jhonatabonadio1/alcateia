# Godot 4+ specific ignores
.godot/
/android/

# macOS
.DS_Store

# .NET
bin/
obj/

# Mapa de referência: vem extraído do cliente original, então fica
# local. Versionar republicaria arte de terceiros — e 22 MB de binário
# por commit. Veja assets/maps/LEIA-ME.md.
assets/maps/arrival/

# Python
__pycache__/

# Pacotes NuGet locais do Godot .NET (cópia de GodotSharp/Tools/nupkgs,
# só para compilar fora do editor). Cada máquina tem os seus.
tools/nupkgs/

# Texturas que o Godot extrai dos .fbx na importação (exo_gray_0.png,
# mutant_red_1.png...). Saem do próprio .fbx, então cada máquina gera
# as suas.
assets/characters/**/*_[0-9].png
assets/characters/**/*_[0-9].png.import
assets/characters/**/*_alpha_[0-9].png
assets/characters/**/*_alpha_[0-9].png.import

# Pacotes de arte baixados (Poly Haven, Sketchfab): matéria-prima,
# grande, refeita por tools/baixar_pacotes.py. Veja docs/PACOTES.md.
assets/pacotes/

# Os segredos do servidor (copie de .env.exemplo).
.env

# Pasta de troca de arquivos com o Claude (pacotes e bundles): não versionar.
.synctmp/
