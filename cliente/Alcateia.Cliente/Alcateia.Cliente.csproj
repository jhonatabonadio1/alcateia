<Project Sdk="Microsoft.NET.Sdk">

	<!--
	O Initech Launcher, o cliente de instalação da Initech Games (Jhon, 27/11:
	"um cliente de instalação igual o battle.net"; "ele é iniciado da initech
	games [...] lá tem o wolfleague, não é exclusivo do wolfleague"): entra na
	conta, mostra a biblioteca de jogos do estúdio, baixa, mantém atualizado,
	repara, desinstala, mostra os amigos e abre o jogo já com a conta entrada.
	O executável continua WolfLeagueLauncher: é o nome que a atualização
	automática e os atalhos de quem já instalou conhecem.

	A interface é Avalonia (o mesmo C# do jogo e do servidor, em Windows e
	Mac); o download e a atualização por diferença são de Alcateia.Pacote.
	Por que assim: docs/decisoes/0021-cliente-de-instalacao.md. Como montar e
	publicar: cliente/LEIA-ME.md.

	Propriedades que o pipeline passa (dotnet publish -p:Nome=valor):
	  Version       a versão do cliente (a da tag)
	  ServidorUrl   o servidor de contas e amigos (padrão: o de produção)
	-->

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>WolfLeagueLauncher</AssemblyName>
		<Product>Initech Launcher</Product>
		<AssemblyTitle>Initech Launcher</AssemblyTitle>
		<Company>Initech Games</Company>
		<RootNamespace>Alcateia.Cliente</RootNamespace>
		<Version>0.0.0-dev</Version>
		<ServidorUrl Condition="'$(ServidorUrl)' == ''">https://wolfleague-api.fly.dev</ServidorUrl>
		<ApplicationIcon>../../instalador/WolfLeagueLauncher.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<InvariantGlobalization>true</InvariantGlobalization>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<!-- A versão vai sem o "+commit" no fim: é ela que se compara com a do manifesto. -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="ServidorUrl" Value="$(ServidorUrl)" />
		<!-- As fotos das telas montam estados de mentira (Preview). -->
		<InternalsVisibleTo Include="fotos" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.2.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
		<ProjectReference Include="../Alcateia.Pacote/Alcateia.Pacote.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- O estúdio: o emblema e o nome da logo (recortados de src/assets/ui/estudio, os da vinheta do jogo) e o ícone. -->
		<AvaloniaResource Include="Assets/*.png" />
		<AvaloniaResource Include="../../instalador/WolfLeagueLauncher.ico" Link="Assets/icone.ico" />
		<!-- Os textos em cada idioma (Core/Tr.cs). -->
		<AvaloniaResource Include="Assets/i18n/launcher.csv" />
		<!-- Cada jogo da biblioteca (Core/Games.cs): a arte e o logo são os do próprio jogo, um arquivo só no repositório. -->
		<AvaloniaResource Include="Assets/jogos/**/*.png" />
		<AvaloniaResource Include="../../src/assets/personagens/eve/thumb.jpg" Link="Assets/jogos/wolfleague/arte.jpg" />
		<AvaloniaResource Include="../../src/assets/ui/marca/wolfleague_logo_horizontal.png" Link="Assets/jogos/wolfleague/logo.png" />
		<!-- As letras: Figtree para ler; Barlow Condensed (a do launcher, perto da logo da Initech) nos títulos e botões. OFL.
		     A Kanit fica para o que é do WolfLeague. -->
		<!-- A Figtree em pesos fixos, tirados da variável do jogo por cliente/ferramentas/gerar_figtree.py:
		     o Avalonia não aplica o peso de fonte variável (saía tudo fino). -->
		<AvaloniaResource Include="Assets/Fonts/*.ttf" />
		<AvaloniaResource Include="../../src/assets/fonts/Kanit-SemiBold.ttf" Link="Assets/Fonts/Kanit-SemiBold.ttf" />
		<AvaloniaResource Include="../../src/assets/fonts/Kanit-SemiBoldItalic.ttf" Link="Assets/Fonts/Kanit-SemiBoldItalic.ttf" />
		<AvaloniaResource Include="../../src/assets/fonts/Kanit-BoldItalic.ttf" Link="Assets/Fonts/Kanit-BoldItalic.ttf" />
		<AvaloniaResource Include="../../src/assets/fonts/BarlowCondensed-SemiBold.ttf" Link="Assets/Fonts/BarlowCondensed-SemiBold.ttf" />
		<AvaloniaResource Include="../../src/assets/fonts/BarlowCondensed-Bold.ttf" Link="Assets/Fonts/BarlowCondensed-Bold.ttf" />
	</ItemGroup>

</Project>
