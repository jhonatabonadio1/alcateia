<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Alcateia.Cliente.ViewModels"
        xmlns:v="using:Alcateia.Cliente.Views"
        x:Class="Alcateia.Cliente.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="WolfLeague"
        Icon="/Assets/icone.ico"
        Width="1200" Height="740" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen">

	<Grid>
		<!-- sem conta: a entrada -->
		<Panel IsVisible="{Binding IsLoggedOut}">
			<v:LoginView DataContext="{Binding Login}" />
		</Panel>

		<!-- com conta: a barra do alto, a página e os amigos -->
		<Grid IsVisible="{Binding IsLoggedIn}" RowDefinitions="Auto,60,*" ColumnDefinitions="*,304">

			<!-- a versão nova do cliente já baixou -->
			<Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Gold}" Padding="20,7" IsVisible="{Binding HasUpdateBanner}">
				<StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
					<TextBlock Text="{Binding UpdateBanner}" Foreground="{StaticResource GoldInk}" FontWeight="SemiBold" VerticalAlignment="Center" />
					<Button Content="REINICIAR AGORA" Command="{Binding RestartNow}" Padding="12,4" FontSize="13" />
				</StackPanel>
			</Border>

			<Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource Deep}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
				<Grid ColumnDefinitions="Auto,*,Auto">
					<Image Grid.Column="0" Source="/Assets/logo.png" Height="24" Margin="24,0,30,0" VerticalAlignment="Center" />

					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<Button Classes="tab" Classes.on="{Binding IsGame}" Content="JOGO" Command="{Binding GoGame}" />
						<Button Classes="tab" Classes.on="{Binding IsNews}" Content="NOVIDADES" Command="{Binding GoNews}" />
						<Button Classes="tab" Classes.on="{Binding IsSettings}" Content="CONFIGURAÇÕES" Command="{Binding GoSettings}" />
					</StackPanel>

					<!-- você: clicar copia Nome#0000 -->
					<Button Grid.Column="2" Classes="ghost plain" Command="{Binding CopyHandle}" Margin="0,0,12,0" Padding="10,6"
					        ToolTip.Tip="Copiar o seu nome com a tag, para passar a um amigo">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource Gold}">
								<TextBlock Text="{Binding MeInitial}" Foreground="{StaticResource GoldInk}" FontWeight="Bold" FontSize="16"
								           HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<StackPanel VerticalAlignment="Center" Spacing="0">
								<StackPanel Orientation="Horizontal" Spacing="3">
									<TextBlock Text="{Binding MeName}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Ink}" />
									<TextBlock Text="{Binding MeTag}" FontSize="15" Foreground="{StaticResource Ink3}" />
								</StackPanel>
								<TextBlock Text="{Binding MeLevel}" FontSize="12" Foreground="{StaticResource Ink2}" />
							</StackPanel>
						</StackPanel>
					</Button>
				</Grid>
			</Border>

			<Panel Grid.Row="2" Grid.Column="0">
				<Panel IsVisible="{Binding IsGame}">
					<v:GameView DataContext="{Binding Game}" />
				</Panel>
				<Panel IsVisible="{Binding IsNews}">
					<v:NewsView DataContext="{Binding Game}" />
				</Panel>
				<Panel IsVisible="{Binding IsSettings}">
					<v:SettingsView />
				</Panel>
			</Panel>

			<v:FriendsView Grid.Row="2" Grid.Column="1" DataContext="{Binding Friends}" />
		</Grid>

		<!-- o aviso curto, no pé -->
		<Border IsVisible="{Binding HasToast}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
		        Background="#F2111A26" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="18,11" MaxWidth="640">
			<StackPanel Orientation="Horizontal" Spacing="10">
				<Border Width="4" Background="{StaticResource Gold}" IsVisible="{Binding ToastIsInfo}" />
				<Border Width="4" Background="{StaticResource Danger}" IsVisible="{Binding ToastIsError}" />
				<TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" MaxWidth="580" VerticalAlignment="Center" />
			</StackPanel>
		</Border>

		<!-- ligar ou desligar a verificação em duas etapas -->
		<Border IsVisible="{Binding HasTwoFactor}" Background="#CC060B11">
			<v:TwoFactorView DataContext="{Binding TwoFactor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
		</Border>

		<!-- a pergunta por cima de tudo -->
		<Border IsVisible="{Binding HasModal}" Background="#CC060B11">
			<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Background="{StaticResource Surface}"
			        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="28,24">
				<StackPanel Spacing="14">
					<TextBlock Classes="title" FontSize="24" Text="{Binding Modal.Title}" TextWrapping="Wrap" />
					<TextBlock Classes="muted" Text="{Binding Modal.Body}" TextWrapping="Wrap" LineHeight="22" />
					<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
						<Button Content="VOLTAR" Command="{Binding Modal.Dismiss}" />
						<Button Classes="danger" Content="{Binding Modal.ConfirmText}" Command="{Binding Modal.Confirm}" IsVisible="{Binding Modal.Danger}" />
						<Button Classes="primary" Content="{Binding Modal.ConfirmText}" Command="{Binding Modal.Confirm}" IsVisible="{Binding Modal.Normal}" />
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>
	</Grid>
</Window>
