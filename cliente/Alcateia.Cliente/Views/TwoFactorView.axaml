<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alcateia.Cliente.ViewModels"
             x:Class="Alcateia.Cliente.Views.TwoFactorView"
             x:DataType="vm:TwoFactorViewModel">

	<Border Width="560" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="28,24">
		<StackPanel Spacing="14">
			<TextBlock Classes="title" FontSize="24" Text="{Binding Title}" TextWrapping="Wrap" />

			<!-- ligar: o QR code, a chave e o primeiro código -->
			<Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsEnable}">
				<Border Grid.Column="0" Background="White" Padding="12" CornerRadius="2" Width="196" Height="196" VerticalAlignment="Top">
					<Path Data="{Binding Qr}" Fill="Black" Stretch="Uniform" />
				</Border>
				<StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="10">
					<TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="21"
					           Text="1. No celular, abra um aplicativo autenticador (Google Authenticator, Authy, 1Password) e aponte a câmera para o QR code." />
					<StackPanel Spacing="4">
						<TextBlock Classes="label" Text="OU DIGITE A CHAVE" />
						<TextBlock Text="{Binding Secret}" FontWeight="SemiBold" TextWrapping="Wrap" />
						<Button Classes="ghost" Content="COPIAR A CHAVE" Command="{Binding CopyKey}" HorizontalAlignment="Left" Padding="0,2" FontSize="13" />
					</StackPanel>
					<TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="21" Text="2. Digite aqui o código de 6 dígitos que o aplicativo mostra:" />
				</StackPanel>
			</Grid>

			<!-- desligar: a senha -->
			<StackPanel Spacing="10" IsVisible="{Binding IsDisable}">
				<TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="21"
				           Text="Sem ela, quem descobrir a sua senha entra na conta. Para desligar, confirme a senha e um código do aplicativo autenticador." />
				<StackPanel Spacing="6">
					<TextBlock Classes="label" Text="SENHA" />
					<TextBox Text="{Binding Password}" PasswordChar="•" MaxLength="128" />
				</StackPanel>
			</StackPanel>

			<StackPanel Spacing="6">
				<TextBlock Classes="label" Text="CÓDIGO DO AUTENTICADOR" />
				<TextBox Text="{Binding Code}" MaxLength="7" PlaceholderText="000000" FontSize="20" LetterSpacing="4" Width="170" HorizontalAlignment="Left">
					<TextBox.KeyBindings>
						<KeyBinding Gesture="Enter" Command="{Binding Confirm}" />
					</TextBox.KeyBindings>
				</TextBox>
			</StackPanel>

			<Panel IsVisible="{Binding HasStatus}">
				<TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Danger}" IsVisible="{Binding StatusIsError}" />
				<TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" IsVisible="{Binding !StatusIsError}" />
			</Panel>

			<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0">
				<Button Content="VOLTAR" Command="{Binding Close}" />
				<Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding Confirm}" IsVisible="{Binding IsEnable}" />
				<Button Classes="danger" Content="{Binding ConfirmText}" Command="{Binding Confirm}" IsVisible="{Binding IsDisable}" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
