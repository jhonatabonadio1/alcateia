<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alcateia.Cliente.ViewModels"
             xmlns:c="using:Alcateia.Cliente.Core"
             x:Class="Alcateia.Cliente.Views.LoginView"
             x:DataType="vm:LoginViewModel">

	<!--
	A entrada do Initech Launcher: o formulário à esquerda e, à direita, o
	estúdio — o emblema com o brilho quente da vinheta do jogo, e o nome.
	A conta é a mesma em todos os jogos da Initech.
	-->
	<Grid ColumnDefinitions="460,*">
		<Panel Grid.Column="1" ClipToBounds="True" Background="{StaticResource Deep}">
			<Border>
				<Border.Background>
					<RadialGradientBrush Center="50%,46%" GradientOrigin="50%,46%" RadiusX="55%" RadiusY="60%">
						<GradientStop Offset="0" Color="#3DFEC803" />
						<GradientStop Offset="0.45" Color="#0FFEC803" />
						<GradientStop Offset="1" Color="#00FEC803" />
					</RadialGradientBrush>
				</Border.Background>
			</Border>
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="34">
				<Image Source="/Assets/initech_emblema.png" Height="260" />
				<StackPanel Spacing="14" HorizontalAlignment="Center">
					<Image Source="/Assets/initech_nome.png" Height="40" />
					<Image Source="/Assets/initech_games.png" Height="14" />
				</StackPanel>
			</StackPanel>
		</Panel>

		<Border Grid.Column="0" Background="{StaticResource Night}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="44,48,44,32" Spacing="14">
					<StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
						<Image Source="/Assets/initech_emblema.png" Height="30" />
						<Image Source="/Assets/initech_nome.png" Height="16" VerticalAlignment="Center" />
					</StackPanel>
					<TextBlock Classes="label" Text="LAUNCHER" LetterSpacing="5" Margin="0,0,0,14" />

					<StackPanel Orientation="Horizontal" Margin="0,0,0,6" Height="36">
						<Button Classes="tab" Classes.on="{Binding IsLogin}" Content="{c:T login.tab_enter}" Command="{Binding ShowLogin}" />
						<Button Classes="tab" Classes.on="{Binding IsRegister}" Content="{c:T login.tab_create}" Command="{Binding ShowRegister}" />
					</StackPanel>

					<StackPanel Spacing="6">
						<TextBlock Classes="label" Text="{c:T login.name}" />
						<TextBox Text="{Binding Name}" MaxLength="16" PlaceholderText="{c:T login.name_hint}">
							<TextBox.KeyBindings>
								<KeyBinding Gesture="Enter" Command="{Binding Submit}" />
							</TextBox.KeyBindings>
						</TextBox>
					</StackPanel>
					<StackPanel Spacing="6">
						<TextBlock Classes="label" Text="{c:T login.password}" />
						<TextBox Text="{Binding Password}" PasswordChar="•" MaxLength="128" PlaceholderText="{c:T login.password_hint}">
							<TextBox.KeyBindings>
								<KeyBinding Gesture="Enter" Command="{Binding Submit}" />
							</TextBox.KeyBindings>
						</TextBox>
					</StackPanel>
					<StackPanel Spacing="6" IsVisible="{Binding IsRegister}">
						<TextBlock Classes="label" Text="{c:T login.password_again}" />
						<TextBox Text="{Binding Confirm}" PasswordChar="•" MaxLength="128">
							<TextBox.KeyBindings>
								<KeyBinding Gesture="Enter" Command="{Binding Submit}" />
							</TextBox.KeyBindings>
						</TextBox>
					</StackPanel>

					<!-- só aparece para a conta com verificação em duas etapas, depois da senha certa -->
					<StackPanel Spacing="6" IsVisible="{Binding NeedsCode}">
						<TextBlock Classes="label" Text="{c:T login.code}" Foreground="{StaticResource Gold}" />
						<TextBox Text="{Binding Code}" MaxLength="7" PlaceholderText="{c:T login.code_hint}" FontSize="18">
							<TextBox.KeyBindings>
								<KeyBinding Gesture="Enter" Command="{Binding Submit}" />
							</TextBox.KeyBindings>
						</TextBox>
					</StackPanel>

					<CheckBox IsChecked="{Binding Remember}" Content="{c:T login.remember}" />

					<Button Classes="primary" Content="{Binding SubmitText}" Command="{Binding Submit}" HorizontalAlignment="Stretch" FontSize="20" Padding="18,11" Margin="0,4,0,0" />

					<Panel IsVisible="{Binding HasStatus}">
						<TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Danger}" IsVisible="{Binding StatusIsError}" />
						<TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" IsVisible="{Binding !StatusIsError}" />
					</Panel>

					<!-- as contas salvas neste computador -->
					<StackPanel Spacing="8" Margin="0,18,0,0" IsVisible="{Binding HasSaved}">
						<TextBlock Classes="label" Text="{c:T login.saved}" />
						<ItemsControl ItemsSource="{Binding Saved}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:SavedAccountItem">
									<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
										<Button Grid.Column="0" Classes="plain" Command="{Binding Enter}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8">
											<StackPanel Orientation="Horizontal" Spacing="10">
												<Border Width="30" Height="30" Background="{StaticResource Gold}">
													<TextBlock Text="{Binding Initial}" Foreground="{StaticResource GoldInk}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
												</Border>
												<TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
												<TextBlock Text="{Binding Tag}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="-7,0,0,0" />
											</StackPanel>
										</Button>
										<Button Grid.Column="1" Classes="mini" Command="{Binding Forget}" Margin="6,0,0,0" Height="46" Width="34"
										        ToolTip.Tip="{c:T login.forget}">
											<Path Data="M3,3 L11,11 M11,3 L3,11" Stroke="{StaticResource Ink2}" StrokeThickness="1.6" Width="14" Height="14" />
										</Button>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<TextBlock Text="{Binding ServerText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
