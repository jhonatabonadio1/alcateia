<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alcateia.Cliente.ViewModels"
             x:Class="Alcateia.Cliente.Views.NewsView"
             x:DataType="vm:GameViewModel">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="40,34,40,40" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
			<TextBlock Classes="label" Text="NOVIDADES" Foreground="{StaticResource Gold}" />
			<TextBlock Classes="title" Text="{Binding NotesTitle}" TextWrapping="Wrap" />
			<TextBlock Text="{Binding Notes}" TextWrapping="Wrap" LineHeight="24" Foreground="{StaticResource Ink2}" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
