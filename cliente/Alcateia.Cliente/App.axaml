<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Alcateia.Cliente.App"
             Name="WolfLeague"
             RequestedThemeVariant="Dark">

	<!--
	A cara do cliente: as cores do menu do jogo (src/scripts/ui/kit/UiTokens.cs,
	paleta Menu — as mesmas do instalador) e as letras dos menus dele
	(src/scripts/ui/kit/UiFonts.cs; Jhon, 27/11: "essa fonte tem que casar
	com as do game atual"): Figtree para ler e nos rótulos em caixa alta,
	Kanit itálica nos títulos e nos botões. Mudou a letra do jogo, muda aqui.
	-->
	<Application.Resources>
		<Color x:Key="NightColor">#0A1119</Color>
		<!-- A cor de destaque do tema (caixas de marcar, foco): o ouro do jogo, não o azul do sistema. -->
		<Color x:Key="SystemAccentColor">#F3B950</Color>
		<Color x:Key="SystemAccentColorDark1">#E0A63C</Color>
		<Color x:Key="SystemAccentColorLight1">#FFCE73</Color>
		<SolidColorBrush x:Key="Night" Color="#0A1119" />
		<SolidColorBrush x:Key="Deep" Color="#060B11" />
		<SolidColorBrush x:Key="Surface" Color="#111A26" />
		<SolidColorBrush x:Key="Surface2" Color="#16212F" />
		<SolidColorBrush x:Key="Line" Color="#223144" />
		<SolidColorBrush x:Key="Ink" Color="#EDF2F7" />
		<SolidColorBrush x:Key="Ink2" Color="#9DB0C4" />
		<SolidColorBrush x:Key="Ink3" Color="#5E7186" />
		<SolidColorBrush x:Key="Gold" Color="#F3B950" />
		<SolidColorBrush x:Key="GoldHot" Color="#FFCE73" />
		<SolidColorBrush x:Key="GoldInk" Color="#1A1204" />
		<SolidColorBrush x:Key="Danger" Color="#F0655A" />
		<SolidColorBrush x:Key="Ok" Color="#4ADE80" />
		<FontFamily x:Key="Body">avares://WolfLeagueLauncher/Assets/Fonts#Figtree</FontFamily>
		<FontFamily x:Key="Display">avares://WolfLeagueLauncher/Assets/Fonts#Kanit</FontFamily>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />

		<Style Selector="Window">
			<Setter Property="FontFamily" Value="{StaticResource Body}" />
			<Setter Property="FontSize" Value="15" />
			<Setter Property="Background" Value="{StaticResource Night}" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
		</Style>

		<!-- rótulo pequeno em caixa alta, afastado -->
		<Style Selector="TextBlock.label">
			<Setter Property="FontFamily" Value="{StaticResource Body}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="LetterSpacing" Value="1" />
			<Setter Property="Foreground" Value="{StaticResource Ink3}" />
		</Style>
		<Style Selector="TextBlock.title">
			<Setter Property="FontFamily" Value="{StaticResource Display}" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="FontSize" Value="30" />
		</Style>
		<Style Selector="TextBlock.muted">
			<Setter Property="Foreground" Value="{StaticResource Ink2}" />
		</Style>

		<!-- botões: base -->
		<Style Selector="Button">
			<Setter Property="FontFamily" Value="{StaticResource Display}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="FontSize" Value="15" />
			<Setter Property="CornerRadius" Value="2" />
			<Setter Property="Padding" Value="18,9" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Background" Value="{StaticResource Surface2}" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
			<Setter Property="BorderBrush" Value="{StaticResource Line}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#1D2B3D" />
			<Setter Property="BorderBrush" Value="#35485F" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
		</Style>
		<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#16212F" />
		</Style>
		<Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#111A26" />
			<Setter Property="Foreground" Value="{StaticResource Ink3}" />
			<Setter Property="BorderBrush" Value="#1A2636" />
		</Style>

		<!-- a ação que leva adiante: ouro -->
		<Style Selector="Button.primary">
			<Setter Property="Background" Value="{StaticResource Gold}" />
			<Setter Property="Foreground" Value="{StaticResource GoldInk}" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{StaticResource GoldHot}" />
			<Setter Property="Foreground" Value="{StaticResource GoldInk}" />
		</Style>
		<Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#E0A63C" />
			<Setter Property="Foreground" Value="{StaticResource GoldInk}" />
		</Style>
		<Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#2A3545" />
			<Setter Property="Foreground" Value="#7C8DA1" />
		</Style>
		<Style Selector="Button.hero">
			<Setter Property="FontSize" Value="26" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Padding" Value="46,14" />
			<Setter Property="MinWidth" Value="240" />
		</Style>

		<Style Selector="Button.danger">
			<Setter Property="Background" Value="#3A1B1B" />
			<Setter Property="BorderBrush" Value="#7A3530" />
			<Setter Property="Foreground" Value="#FFB4AC" />
		</Style>
		<Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#522321" />
			<Setter Property="BorderBrush" Value="{StaticResource Danger}" />
			<Setter Property="Foreground" Value="#FFD3CE" />
		</Style>

		<!-- botão que carrega texto de ler (um nome, uma conta): a letra de ler, em pé -->
		<Style Selector="Button.plain">
			<Setter Property="FontFamily" Value="{StaticResource Body}" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontWeight" Value="Normal" />
		</Style>

		<!-- sem placa: só o texto -->
		<Style Selector="Button.ghost">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{StaticResource Ink2}" />
			<Setter Property="Padding" Value="10,6" />
		</Style>
		<Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#14FFFFFF" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
		</Style>

		<!-- aba do alto -->
		<Style Selector="Button.tab">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0,0,0,2" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="Foreground" Value="{StaticResource Ink2}" />
			<Setter Property="FontFamily" Value="{StaticResource Body}" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="LetterSpacing" Value="1" />
			<Setter Property="Padding" Value="16,0" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
		</Style>
		<Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
		</Style>
		<Style Selector="Button.tab.on">
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
			<Setter Property="BorderBrush" Value="{StaticResource Gold}" />
		</Style>
		<Style Selector="Button.tab.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="BorderBrush" Value="{StaticResource Gold}" />
		</Style>

		<!-- botão pequeno de linha (aceitar, recusar, remover) -->
		<Style Selector="Button.mini">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Width" Value="28" />
			<Setter Property="Height" Value="28" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{StaticResource Ink2}" />
		</Style>
		<Style Selector="Button.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#1FFFFFFF" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
		</Style>

		<Style Selector="TextBox">
			<Setter Property="Background" Value="{StaticResource Deep}" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
			<Setter Property="BorderBrush" Value="{StaticResource Line}" />
			<Setter Property="CornerRadius" Value="2" />
			<Setter Property="Padding" Value="12,9" />
			<Setter Property="FontSize" Value="15" />
			<Setter Property="MinHeight" Value="40" />
			<Setter Property="CaretBrush" Value="{StaticResource Gold}" />
		</Style>
		<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{StaticResource Deep}" />
			<Setter Property="BorderBrush" Value="#35485F" />
		</Style>
		<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{StaticResource Deep}" />
			<Setter Property="BorderBrush" Value="{StaticResource Gold}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<Style Selector="ProgressBar">
			<Setter Property="Height" Value="6" />
			<Setter Property="MinHeight" Value="6" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="Background" Value="#33FFFFFF" />
			<Setter Property="Foreground" Value="{StaticResource Gold}" />
		</Style>

		<Style Selector="CheckBox">
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
			<Setter Property="FontSize" Value="15" />
		</Style>
	</Application.Styles>
</Application>
