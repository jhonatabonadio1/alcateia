<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Os testes de unidade são um projeto à parte, sem Godot
         (tests/unit/Alcateia.UnitTests.csproj). Os de regressão, em
         tests/regression, rodam dentro do jogo e ficam aqui. -->
    <Compile Remove="tests/unit/**" />
    <!-- O servidor (contas, salas, frota) é outro programa, em ASP.NET:
         servidor/Alcateia.Servidor. -->
    <Compile Remove="servidor/**" />
  </ItemGroup>
</Project>