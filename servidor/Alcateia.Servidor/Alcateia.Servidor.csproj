<Project Sdk="Microsoft.NET.Sdk.Web">

	<!--
	O servidor do Alcateia: contas, perfil, salas, chat, ranking e a frota
	de servidores de partida. Este projeto é a borda — HTTP, WebSocket,
	configuração e a montagem de tudo (App.cs); as regras estão em
	Alcateia.Dominio, os casos de uso em Alcateia.Aplicacao e o banco em
	Alcateia.Infra. ASP.NET Core puro, sem pacote nenhum: só o que vem no
	.NET 8 (veja servidor/LEIA-ME.md).

	Rodar: docker compose up (na raiz) ou, com um Postgres à mão,
	dotnet run dentro desta pasta com as variáveis de ALCATEIA_*.
	-->

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>Alcateia.Servidor</RootNamespace>
		<AssemblyName>Alcateia.Servidor</AssemblyName>
		<InvariantGlobalization>true</InvariantGlobalization>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<!-- As camadas (clean architecture): esta é a de fora, a API.
		     Dominio ← Aplicacao ← Infra ← Servidor; cada uma só conhece as
		     de dentro. -->
		<ProjectReference Include="../Alcateia.Infra/Alcateia.Infra.csproj" />
	</ItemGroup>

</Project>
