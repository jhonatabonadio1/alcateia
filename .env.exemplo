# Copie para ".env" (que não vai para o git) e troque os dois segredos.
# Gere cada um com:  openssl rand -hex 32

# Senha do banco de dados.
ALCATEIA_DB_PASSWORD=troque-esta-senha

# O segredo entre o servidor e os servidores de partida.
ALCATEIA_FLEET_KEY=troque-este-segredo

# O endereço pelo qual os jogadores chegam nesta máquina: o IP dela na
# rede (para jogar em casa) ou o IP público/domínio (pela internet).
ALCATEIA_PUBLIC_ADDRESS=127.0.0.1

# Porta do servidor (API e lobby).
ALCATEIA_PORT=8080
