# Copie para ".env" (que não vai para o git) e troque os segredos.
# Gere cada um com:  openssl rand -hex 32
# O que cada variável faz e o porquê: docs/SERVIDOR.md e docs/SEGURANCA.md.

# Senha do banco de dados.
ALCATEIA_DB_PASSWORD=troque-esta-senha

# O segredo entre o servidor e os servidores de partida.
ALCATEIA_FLEET_KEY=troque-este-segredo

# A chave que cifra o que não pode ficar legível no banco (o segredo da
# verificação em duas etapas dos administradores). Guarde uma cópia fora
# do servidor: sem ela, todos precisam ligar as duas etapas de novo.
ALCATEIA_MASTER_KEY=troque-esta-chave

# O endereço pelo qual os jogadores chegam nesta máquina: o IP dela na
# rede (para jogar em casa) ou o IP público/domínio (pela internet).
ALCATEIA_PUBLIC_ADDRESS=127.0.0.1

# Porta do servidor (API e lobby).
ALCATEIA_PORT=8080

# ---------------------------------------------------------------- painel

# O primeiro administrador (o dono). Só é usado enquanto não existe
# nenhum; depois de entrar e trocar a senha, apague estas duas linhas.
# A senha tem de ter 12 caracteres ou mais.
ALCATEIA_ADMIN_USER=
ALCATEIA_ADMIN_PASSWORD=

# Porta do painel, publicada só em 127.0.0.1 (túnel SSH ou VPN).
ALCATEIA_ADMIN_PORT=8081

# 1: ninguém usa o painel sem ligar a verificação em duas etapas.
ALCATEIA_ADMIN_REQUIRE_2FA=0

# Quem pode falar com o painel (endereços ou faixas, separados por
# vírgula). Vazio: quem alcançar a porta.
ALCATEIA_ADMIN_ALLOW=

# ---------------------------------------------------------------- segurança

# Endereços que o escudo nunca bloqueia nem freia (o escritório, o
# monitoramento), separados por vírgula.
ALCATEIA_IP_ALLOW=

# De quem o servidor aceita o endereço real do jogador (o proxy da
# frente). O docker-compose.producao.yml já define para o Caddy.
ALCATEIA_TRUSTED_PROXIES=

# ---------------------------------------------------------------- produção
# (docker-compose.producao.yml e docker-compose.monitor.yml)

# O domínio do servidor, apontando para esta máquina (HTTPS automático).
ALCATEIA_DOMAIN=

# A chave que o Prometheus apresenta para ler /metrics.
ALCATEIA_METRICS_KEY=

# A senha do usuário "admin" do Grafana.
GRAFANA_PASSWORD=
