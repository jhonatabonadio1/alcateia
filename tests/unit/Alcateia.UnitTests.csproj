<Project Sdk="Microsoft.NET.Sdk">

	<!--
	Testes de unidade das regras do jogo: C# puro, sem Godot e sem pacote
	nenhum (roda sem internet, no Mac, no contêiner e no CI).

	Rodar: tools/testar.sh (tudo) ou "dotnet run" dentro de tests/unit.

	O que entra aqui é o núcleo de regras (scripts/domain), compilado de
	novo neste projeto. Arquivo que usa Godot não entra: se uma regra
	precisa de teste, ela vai para o domínio.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>Alcateia.UnitTests</RootNamespace>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../../scripts/domain/**/*.cs" LinkBase="domain" />
		<Compile Include="../../scripts/forms/WolfMoves.cs" Link="domain/WolfMoves.cs" />
	</ItemGroup>

</Project>
